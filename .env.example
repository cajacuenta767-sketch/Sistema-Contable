# PostgreSQL
DATABASE_URL="postgresql://contable:contable@localhost:5432/sistema_contable?schema=public"

# Secreto para firmar los JWT de sesion. Genera uno con: openssl rand -base64 48
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-min-32-chars"

# Duracion de la sesion en segundos (por defecto 8 horas)
SESSION_TTL_SECONDS="28800"

# Token para invocar los jobs programados via HTTP (POST /api/jobs/...)
CRON_SECRET="cambia-esto-tambien"

# Zona horaria de negocio. Todo vencimiento se evalua en esta zona.
BUSINESS_TIMEZONE="America/Lima"
